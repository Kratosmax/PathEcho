<Window x:Class="PathEcho.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:PathEcho.Services"
        Title="PathEcho" Width="1180" Height="760" MinWidth="920" MinHeight="620"
        WindowStartupLocation="CenterScreen" Closing="OnClosing">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="218"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#17201D">
            <Grid Margin="16,20,16,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="24"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Border Width="34" Height="34" CornerRadius="6" Background="#2BB58B">
                        <TextBlock Text="↔" FontSize="20" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="PathEcho" FontSize="18" FontWeight="SemiBold" Foreground="White"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <Button x:Name="SyncNavButton" Content="同步任务" Tag="Sync" Click="OnNavigate" Height="42" Margin="0,0,0,6"
                            Foreground="White" Background="#2B3733" BorderBrush="#2B3733" HorizontalContentAlignment="Left"/>
                    <Button x:Name="GameNavButton" Content="游戏存档" Tag="Game" Click="OnNavigate" Height="42" Margin="0,0,0,6"
                            Foreground="#D6DFDB" Background="Transparent" BorderBrush="Transparent" HorizontalContentAlignment="Left"/>
                    <Button x:Name="HistoryNavButton" Content="版本历史" Tag="History" Click="OnNavigate" Height="42"
                            Foreground="#D6DFDB" Background="Transparent" BorderBrush="Transparent" HorizontalContentAlignment="Left"/>
                </StackPanel>

                <StackPanel Grid.Row="3">
                    <Separator Background="#35433E" Margin="0,0,0,10"/>
                    <Button x:Name="SettingsNavButton" Content="设置" Tag="Settings" Click="OnNavigate" Height="42"
                            Foreground="#D6DFDB" Background="Transparent" BorderBrush="Transparent" HorizontalContentAlignment="Left"/>
                    <TextBlock x:Name="SidebarVersionText" Foreground="#7F928A" FontSize="11" Margin="12,10,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="32"/>
            </Grid.RowDefinitions>

            <Grid Margin="28,24,28,20">
                <Grid x:Name="SyncView">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="同步任务" FontSize="26" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="DeleteSyncButton" Content="删除选中" Style="{StaticResource DangerButton}" Click="OnDeleteSync" IsEnabled="False" Margin="0,0,8,0"/>
                            <Button Content="全部同步" Click="OnRunAllSync" Margin="0,0,8,0"/>
                            <Button Content="+  新建同步" Style="{StaticResource PrimaryButton}" Click="OnAddSync"/>
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="2">
                        <DataGrid x:Name="SyncGrid" ItemsSource="{Binding SyncTasks}" SelectionChanged="OnSyncSelectionChanged" FrozenColumnCount="1">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="120" ElementStyle="{StaticResource GridTextStyle}"/>
                                <DataGridTextColumn Header="源目录" Binding="{Binding LeftPath}" Width="180" ElementStyle="{StaticResource GridTextStyle}"/>
                                <DataGridTextColumn Header="目标目录" Binding="{Binding RightPath}" Width="180" ElementStyle="{StaticResource GridTextStyle}"/>
                                <DataGridTextColumn Header="模式" Binding="{Binding Mode}" Width="90" ElementStyle="{StaticResource GridTextStyle}"/>
                                <DataGridTextColumn Header="删除" Binding="{Binding Deletion}" Width="110" ElementStyle="{StaticResource GridTextStyle}"/>
                                <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="120" ElementStyle="{StaticResource GridTextStyle}"/>
                                <DataGridTemplateColumn Header="" Width="92">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="立即同步" Padding="8,0" MinHeight="30" Click="OnRunSyncRow"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel x:Name="SyncEmpty" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="↔" FontSize="34" Foreground="#8AA098" HorizontalAlignment="Center"/>
                            <TextBlock Text="还没有同步任务" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,4"/>
                            <Button Content="新建同步" Style="{StaticResource PrimaryButton}" Click="OnAddSync" Margin="0,18,0,0"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <Grid x:Name="GameView" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="游戏存档" FontSize="26" FontWeight="SemiBold"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="DeleteGameButton" Content="删除选中" Style="{StaticResource DangerButton}" Click="OnDeleteGame" IsEnabled="False" Margin="0,0,8,0"/>
                            <Button Content="+  添加游戏" Style="{StaticResource PrimaryButton}" Click="OnAddGame"/>
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="2">
                        <DataGrid x:Name="GameGrid" ItemsSource="{Binding GameProfiles}" SelectionChanged="OnGameSelectionChanged" FrozenColumnCount="1">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="游戏" Binding="{Binding Name}" Width="1.2*" MinWidth="130" ElementStyle="{StaticResource GridTextStyle}"/>
                                <DataGridTextColumn Header="存档目录" Binding="{Binding SaveDirectory}" Width="2.4*" MinWidth="220" ElementStyle="{StaticResource GridTextStyle}"/>
                                <DataGridTextColumn Header="触发方式" Binding="{Binding Triggers}" Width="1.4*" MinWidth="150" ElementStyle="{StaticResource GridTextStyle}"/>
                                <DataGridTextColumn Header="版本" Binding="{Binding RetainedVersions}" Width="70" ElementStyle="{StaticResource GridTextStyle}"/>
                                <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="1.2*" MinWidth="120" ElementStyle="{StaticResource GridTextStyle}"/>
                                <DataGridTemplateColumn Header="" Width="88">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate><Button Content="立即备份" Padding="8,0" MinHeight="30" Click="OnBackupRow"/></DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel x:Name="GameEmpty" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="▣" FontSize="34" Foreground="#8AA098" HorizontalAlignment="Center"/>
                            <TextBlock Text="还没有游戏存档" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,4"/>
                            <Button Content="添加游戏" Style="{StaticResource PrimaryButton}" Click="OnAddGame" Margin="0,18,0,0"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <Grid x:Name="HistoryView" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="版本历史" FontSize="26" FontWeight="SemiBold"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="刷新" Click="OnRefreshHistory" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid Grid.Row="2">
                        <DataGrid x:Name="HistoryGrid" ItemsSource="{Binding History}" FrozenColumnCount="1">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="游戏" Binding="{Binding GameName}" Width="1.2*" MinWidth="130" ElementStyle="{StaticResource GridTextStyle}"/>
                                <DataGridTextColumn Header="备份时间" Binding="{Binding CreatedAt}" Width="155" ElementStyle="{StaticResource GridTextStyle}"/>
                                <DataGridTextColumn Header="触发方式" Binding="{Binding Trigger}" Width="120" ElementStyle="{StaticResource GridTextStyle}"/>
                                <DataGridTextColumn Header="文件数" Binding="{Binding FileCount}" Width="75" ElementStyle="{StaticResource GridTextStyle}"/>
                                <DataGridTextColumn Header="快照目录" Binding="{Binding SnapshotDirectory}" Width="2.2*" MinWidth="220" ElementStyle="{StaticResource GridTextStyle}"/>
                                <DataGridTemplateColumn Header="" Width="138">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="打开" Padding="7,0" MinHeight="30" Click="OnOpenSnapshot" Margin="0,0,5,0"/>
                                                <Button Content="回档" Padding="7,0" MinHeight="30" Style="{StaticResource PrimaryButton}" Click="OnRestoreRow"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel x:Name="HistoryEmpty" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="◷" FontSize="34" Foreground="#8AA098" HorizontalAlignment="Center"/>
                            <TextBlock Text="还没有备份版本" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,4"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <ScrollViewer x:Name="SettingsView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                        <TextBlock Text="设置" FontSize="26" FontWeight="SemiBold"/>
                        <Border Height="24"/>

                        <TextBlock Text="启动与后台" FontSize="16" FontWeight="SemiBold"/>
                        <CheckBox x:Name="StartupCheck" Content="登录 Windows 后自动启动 PathEcho" Margin="0,12,0,2"/>
                        <CheckBox x:Name="MinimizedCheck" Content="启动后保持在通知区域" Margin="0,4,0,2"/>
                        <Separator Margin="0,20"/>

                        <TextBlock Text="游戏备份" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="默认备份目录" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="BackupDirectoryBox"/>
                            <Button Grid.Column="2" Content="浏览" Click="OnBrowseDefaultBackup"/>
                        </Grid>
                        <TextBlock Text="修改后会先迁移并校验使用默认目录的现有备份。" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,6,0,0"/>
                        <Separator Margin="0,20"/>

                        <TextBlock Text="更新" FontSize="16" FontWeight="SemiBold"/>
                        <CheckBox x:Name="UpdateCheck" Content="启动后在后台检查更新" Margin="0,12,0,2"/>
                        <TextBlock x:Name="SettingsVersionText" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,12"/>
                        <TextBlock Text="GitHub URL 前缀线路（可选）" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6"/>
                        <TextBox x:Name="UpdatePrefixBox"/>
                        <TextBlock Text="第三方前缀线路会看到完整 GitHub 下载地址。" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,6,0,12"/>
                        <TextBlock Text="HTTP 出网代理（可选，仅 http://host:port）" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6"/>
                        <TextBox x:Name="HttpProxyBox"/>
                        <Button Content="检查更新" Click="OnCheckForUpdates" HorizontalAlignment="Left" Margin="0,12,0,0"/>

                        <StackPanel Orientation="Horizontal" Margin="0,26,0,12">
                            <Button Content="保存设置" Style="{StaticResource PrimaryButton}" Click="OnSaveSettings"/>
                            <Button Content="发现已有备份" Click="OnDiscoverBackups" Margin="8,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Border Grid.Row="1" Background="#E8EEEB" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                <Grid Margin="28,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusText" Text="就绪" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="BackgroundStatusText" Grid.Column="1" Text="后台监听已启用" Foreground="#167A5B" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
