<Window x:Class="PathEcho.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="clr-namespace:PathEcho.Services"
        xmlns:controls="clr-namespace:PathEcho.Controls"
        Title="PathEcho" Width="1180" Height="760" MinWidth="920" MinHeight="620"
        WindowStartupLocation="CenterScreen" Closing="OnClosing">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="218"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#17201D">
            <Grid Margin="16,20,16,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="24"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Image Width="34" Height="34" Source="/Assets/PathEchoLogo.png"/>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="PathEcho" FontSize="18" FontWeight="SemiBold" Foreground="White"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="2">
                    <Button x:Name="SyncNavButton" Content="同步任务" Tag="Sync" Click="OnNavigate" Height="42" Margin="0,0,0,6"
                            Style="{StaticResource SidebarNavButton}" Foreground="White" Background="#2B3733" BorderBrush="#2B3733"/>
                    <Button x:Name="GameNavButton" Content="游戏存档" Tag="Game" Click="OnNavigate" Height="42" Margin="0,0,0,6"
                            Style="{StaticResource SidebarNavButton}"/>
                    <Button x:Name="HistoryNavButton" Content="版本历史" Tag="History" Click="OnNavigate" Height="42"
                            Style="{StaticResource SidebarNavButton}"/>
                </StackPanel>

                <StackPanel Grid.Row="3">
                    <Separator Background="#35433E" Margin="0,0,0,10"/>
                    <Button x:Name="SettingsNavButton" Content="设置" Tag="Settings" Click="OnNavigate" Height="42"
                            Style="{StaticResource SidebarNavButton}"/>
                    <TextBlock x:Name="SidebarVersionText" Foreground="#7F928A" FontSize="11" Margin="12,10,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="32"/>
            </Grid.RowDefinitions>

            <Grid Margin="28,24,28,20">
                <Grid x:Name="SyncView">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="同步任务" Style="{StaticResource PageTitle}"/>
                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="管理本机目录同步，可先预演再执行。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,12,0"/>
                            <TextBlock x:Name="SyncSummaryText" Grid.Column="1" Text="0 个任务" Foreground="{StaticResource MutedBrush}"/>
                        </Grid>
                        <WrapPanel Margin="0,16,0,0">
                            <Button Content="+  新建同步" Style="{StaticResource PrimaryButton}" Click="OnAddSync" Margin="0,0,8,8"/>
                            <Button x:Name="RunAllSyncButton" Content="全部同步" Click="OnRunAllSync" Margin="0,0,16,8"/>
                            <Button x:Name="PreviewSyncButton" Content="预演" Click="OnPreviewSync" Visibility="Collapsed" Margin="0,0,8,8"/>
                            <Button x:Name="EditSyncButton" Content="编辑" Click="OnEditSync" Visibility="Collapsed" Margin="0,0,8,8"/>
                            <Button x:Name="DeleteSyncButton" Content="删除" Style="{StaticResource DangerButton}" Click="OnDeleteSync" Visibility="Collapsed" Margin="0,0,0,8"/>
                        </WrapPanel>
                    </StackPanel>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="150"/>
                        </Grid.ColumnDefinitions>
                        <Grid>
                            <TextBox x:Name="SyncSearchBox" Padding="34,7,10,7" TextChanged="OnSyncFilterChanged" ToolTip="搜索名称、目录、模式或状态"/>
                            <TextBlock Text="⌕" FontSize="20" Foreground="{StaticResource MutedBrush}" Margin="11,0,0,1" VerticalAlignment="Center" IsHitTestVisible="False"/>
                            <TextBlock x:Name="SyncSearchHint" Text="搜索同步任务" Foreground="#87948F" Margin="34,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Grid>
                        <ComboBox x:Name="SyncStatusFilter" Grid.Column="2" SelectionChanged="OnSyncFilterChanged" ToolTip="按任务状态筛选"/>
                    </Grid>
                    <Grid Grid.Row="4">
                        <DataGrid x:Name="SyncGrid" SelectionChanged="OnSyncSelectionChanged" MouseDoubleClick="OnSyncRowDoubleClick"
                                  PreviewMouseRightButtonDown="OnSyncRowRightClick"
                                  FrozenColumnCount="1">
                            <DataGrid.ContextMenu>
                                <ContextMenu DataContext="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Header="同步预演" Click="OnPreviewSyncMenu"/>
                                    <MenuItem Header="立即同步" Click="OnRunSyncMenu"/>
                                    <Separator/>
                                    <MenuItem Header="编辑任务" Click="OnEditSyncMenu"/>
                                    <MenuItem Header="复制任务" Click="OnDuplicateSyncMenu"/>
                                    <Separator/>
                                    <MenuItem Header="打开源目录" Click="OnOpenLeftDirectory"/>
                                    <MenuItem Header="打开目标目录" Click="OnOpenRightDirectory"/>
                                    <Separator/>
                                    <MenuItem Header="删除任务" Foreground="{StaticResource DangerBrush}" Click="OnDeleteSyncMenu"/>
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="1.1*" MinWidth="120" ElementStyle="{StaticResource GridTextStyle}"/>
                                <DataGridTextColumn Header="源目录" Binding="{Binding LeftPath}" Width="2*" MinWidth="160" ElementStyle="{StaticResource GridTextStyle}"/>
                                <DataGridTextColumn Header="目标目录" Binding="{Binding RightPath}" Width="2*" MinWidth="160" ElementStyle="{StaticResource GridTextStyle}"/>
                                <DataGridTextColumn Header="模式" Binding="{Binding Mode}" Width="100" MinWidth="100" ElementStyle="{StaticResource GridTextStyle}"/>
                                <DataGridTemplateColumn Header="目录状态" Width="104" MinWidth="104">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DirectoryState}" ToolTip="{Binding DirectoryStateDetail}" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDirectoryStateKnown}" Value="False">
                                                                <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding HasDirectoryIssue}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="运行状态" Binding="{Binding Status}" Width="116" MinWidth="116" ElementStyle="{StaticResource GridTextStyle}"/>
                                <DataGridTemplateColumn Header="" Width="60" MinWidth="60">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="▶" Padding="0" Width="30" MinHeight="30" Click="OnRunSyncRow" ToolTip="立即同步"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel x:Name="SyncEmpty" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="↔" FontSize="34" Foreground="#8AA098" HorizontalAlignment="Center"/>
                            <TextBlock Text="还没有同步任务" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,4"/>
                            <TextBlock Text="添加源目录和目标目录，开始持续同步。" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"/>
                            <Button Content="新建同步" Style="{StaticResource PrimaryButton}" Click="OnAddSync" Margin="0,18,0,0"/>
                        </StackPanel>
                        <StackPanel x:Name="SyncNoResults" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="未找到匹配的任务" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <Button Content="清除筛选" Click="OnClearSyncFilter" Margin="0,14,0,0"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <Grid x:Name="GameView" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="游戏存档" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="管理存档目录与备份规则，双击游戏可编辑。" Style="{StaticResource PageDescription}"/>
                        <WrapPanel Margin="0,16,0,0">
                            <Button Content="+  添加游戏" Style="{StaticResource PrimaryButton}" Click="OnAddGame" Margin="0,0,8,8"/>
                            <Button Content="智能识别" Click="OnDiscoverGames" Margin="0,0,8,8"/>
                            <Button Content="导入配置" Click="OnImportGame" Margin="0,0,16,8"/>
                            <Button x:Name="EditGameButton" Content="编辑" Click="OnEditGame" IsEnabled="False" Margin="0,0,8,8"/>
                            <Button x:Name="ExportGameButton" Content="导出配置" Click="OnExportGame" IsEnabled="False" Margin="0,0,8,8"/>
                            <Button x:Name="DeleteGameButton" Content="删除选中" Style="{StaticResource DangerButton}" Click="OnDeleteGame" IsEnabled="False" Margin="0,0,0,8"/>
                        </WrapPanel>
                    </StackPanel>
                    <Grid Grid.Row="2">
                        <DataGrid x:Name="GameGrid" ItemsSource="{Binding GameProfiles}" SelectionChanged="OnGameSelectionChanged"
                                  MouseDoubleClick="OnGameRowDoubleClick" FrozenColumnCount="1">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="游戏" Binding="{Binding Name}" Width="0.9*" MinWidth="120" ElementStyle="{StaticResource GridTextStyle}"/>
                                <DataGridTextColumn Header="存档目录" Binding="{Binding SaveDirectory}" Width="1.7*" MinWidth="180" ElementStyle="{StaticResource GridTextStyle}"/>
                                <DataGridTextColumn Header="触发方式" Binding="{Binding Triggers}" Width="1.05*" MinWidth="100" ElementStyle="{StaticResource GridTextStyle}"/>
                                <DataGridTextColumn Header="保留策略" Binding="{Binding RetentionSummary}" Width="160" MinWidth="160" ElementStyle="{StaticResource GridTextStyle}"/>
                                <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="0.85*" MinWidth="80" ElementStyle="{StaticResource GridTextStyle}"/>
                                <DataGridTemplateColumn Header="" Width="68" MinWidth="68">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate><Button Content="备份" Padding="7,0" MinHeight="30" Click="OnBackupRow"/></DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel x:Name="GameEmpty" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="▣" FontSize="34" Foreground="#8AA098" HorizontalAlignment="Center"/>
                            <TextBlock Text="还没有游戏存档" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,4"/>
                            <TextBlock Text="添加游戏，设置存档目录与自动备份。" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"/>
                            <Button Content="添加游戏" Style="{StaticResource PrimaryButton}" Click="OnAddGame" Margin="0,18,0,0"/>
                        </StackPanel>
                    </Grid>
                </Grid>

                <Grid x:Name="HistoryView" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="版本历史" Style="{StaticResource PageTitle}"/>
                            <TextBlock Text="浏览存档版本与同步记录，双击版本可查看文件。" Style="{StaticResource PageDescription}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="刷新" Click="OnRefreshHistory" Margin="0,0,8,0"/>
                            <Button Content="检查与导出诊断" Click="OnHistoryDiagnostics"/>
                        </StackPanel>
                    </Grid>
                    <TabControl x:Name="HistoryTabs" Grid.Row="2">
                    <TabItem Header="存档版本">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="190"/>
                            </Grid.ColumnDefinitions>
                            <Grid>
                                <TextBox x:Name="HistorySearchBox" Padding="34,7,10,7" TextChanged="OnHistoryFilterChanged" ToolTip="搜索游戏、触发方式、时间或快照目录"/>
                                <TextBlock Text="⌕" FontSize="20" Foreground="{StaticResource MutedBrush}" Margin="11,0,0,1" VerticalAlignment="Center" IsHitTestVisible="False"/>
                                <TextBlock x:Name="HistorySearchHint" Text="搜索存档版本" Foreground="#87948F" Margin="34,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                            </Grid>
                            <ComboBox x:Name="HistoryGameFilter" Grid.Column="2" DisplayMemberPath="Name" SelectionChanged="OnHistoryFilterChanged" ToolTip="按游戏筛选"/>
                        </Grid>
                        <TextBlock x:Name="HistoryDiagnosticSummary" Grid.Row="1" TextWrapping="Wrap" Margin="0,10,0,10" Foreground="{StaticResource MutedBrush}"/>
                        <DataGrid x:Name="HistoryGrid" Grid.Row="2" FrozenColumnCount="1" MouseDoubleClick="OnHistoryRowDoubleClick">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="游戏" Binding="{Binding GameName}" Width="0.9*" MinWidth="120" ElementStyle="{StaticResource GridTextStyle}"/>
                                <DataGridTextColumn Header="备份时间" Binding="{Binding CreatedAt}" Width="168" MinWidth="168" ElementStyle="{StaticResource GridTextStyle}"/>
                                <DataGridTextColumn Header="触发方式" Binding="{Binding Trigger}" Width="100" MinWidth="100" ElementStyle="{StaticResource GridTextStyle}"/>
                                <DataGridTextColumn Header="文件数" Binding="{Binding FileCount}" Width="80" MinWidth="80" ElementStyle="{StaticResource GridTextStyle}"/>
                                <DataGridTextColumn Header="来源 / 状态" Binding="{Binding Availability}" Width="108" MinWidth="108" ElementStyle="{StaticResource GridTextStyle}"/>
                                <DataGridTextColumn Header="快照目录" Binding="{Binding SnapshotDirectory}" Width="1.7*" MinWidth="200" ElementStyle="{StaticResource GridTextStyle}"/>
                                <DataGridTemplateColumn Header="" Width="120" MinWidth="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Content="打开" Padding="7,0" MinHeight="30" Click="OnOpenSnapshot" Margin="0,0,5,0" IsEnabled="{Binding IsContentAvailable}"/>
                                                <Button Content="回档" Padding="7,0" MinHeight="30" Style="{StaticResource PrimaryButton}" Click="OnRestoreRow" IsEnabled="{Binding IsContentAvailable}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel x:Name="HistoryEmpty" Grid.Row="2" MaxWidth="440" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="◷" FontSize="34" Foreground="#8AA098" HorizontalAlignment="Center"/>
                            <TextBlock x:Name="HistoryEmptyTitle" Text="还没有备份版本" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,10,0,4"/>
                            <TextBlock x:Name="HistoryEmptyReason" Text="完成一次游戏备份后，可在这里查看和回档。" TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"/>
                            <Button Content="检查与导出诊断" Click="OnHistoryDiagnostics" Margin="0,16,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel x:Name="HistoryNoResults" Grid.Row="2" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="未找到匹配的存档版本" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <Button Content="清除筛选" Click="OnClearHistoryFilter" Margin="0,14,0,0"/>
                        </StackPanel>
                    </Grid>
                    </TabItem>
                    <TabItem Header="同步运行">
                        <Grid>
                            <DataGrid x:Name="SyncRunsGrid" ItemsSource="{Binding SyncRuns}" FrozenColumnCount="1">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="任务" Binding="{Binding TaskName}" Width="1.2*" MinWidth="130" ElementStyle="{StaticResource GridTextStyle}"/>
                                    <DataGridTextColumn Header="完成时间" Binding="{Binding CompletedAt}" Width="168" MinWidth="168" ElementStyle="{StaticResource GridTextStyle}"/>
                                    <DataGridTextColumn Header="触发" Binding="{Binding Trigger}" Width="100" MinWidth="100" ElementStyle="{StaticResource GridTextStyle}"/>
                                    <DataGridTextColumn Header="结果" Binding="{Binding Result}" Width="100" MinWidth="100" ElementStyle="{StaticResource GridTextStyle}"/>
                                    <DataGridTextColumn Header="详情" Binding="{Binding Summary}" Width="2.4*" MinWidth="260" ElementStyle="{StaticResource GridTextStyle}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel x:Name="SyncRunsEmpty" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="还没有同步运行记录" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </TabItem>
                    </TabControl>
                </Grid>

                <Grid x:Name="SettingsView" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="设置" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="管理启动、备份、通知与更新偏好。" Style="{StaticResource PageDescription}"/>
                    </StackPanel>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,16,0">
                        <ScrollViewer.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextWrapping" Value="Wrap"/>
                            </Style>
                        </ScrollViewer.Resources>
                        <StackPanel Margin="0,0,0,20">

                            <TextBlock Text="启动与后台" Style="{StaticResource SettingsSectionTitle}"/>
                            <CheckBox x:Name="StartupCheck" Content="登录 Windows 后自动启动 PathEcho" Margin="0,12,0,2"/>
                            <CheckBox x:Name="MinimizedCheck" Content="启动后保持在通知区域" Margin="0,4,0,2"/>
                            <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,24"/>

                            <TextBlock Text="游戏备份" Style="{StaticResource SettingsSectionTitle}"/>
                            <TextBlock Text="默认备份目录" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox x:Name="BackupDirectoryBox" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                <Button Grid.Column="2" Content="浏览" Click="OnBrowseDefaultBackup"/>
                            </Grid>
                            <TextBlock Text="修改后会先迁移并校验使用默认目录的现有备份。" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,6,0,0"/>
                            <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,24"/>

                            <TextBlock Text="自动备份通知" Style="{StaticResource SettingsSectionTitle}"/>
                            <TextBlock Text="设置所有游戏共用的通知外观与位置，游戏可单独覆盖。" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,6,0,0"/>
                            <CheckBox x:Name="BackupNotificationCheck" Content="自动备份完成或失败时显示通知" Margin="0,12,0,10"/>
                            <controls:BackupNotificationEditor x:Name="BackupNotificationEditor"
                                                               IsEnabled="{Binding IsChecked, ElementName=BackupNotificationCheck}"/>
                            <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,24"/>

                            <TextBlock Text="网络与更新" Style="{StaticResource SettingsSectionTitle}"/>
                            <CheckBox x:Name="UpdateCheck" Content="启动后在后台检查更新" Margin="0,12,0,2"/>
                            <TextBlock x:Name="SettingsVersionText" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,12"/>
                            <TextBlock x:Name="StartupUpdateStatusText" Text="本次启动尚未自动检查更新" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,12"/>
                            <TextBlock Text="GitHub 线路" Foreground="{StaticResource MutedBrush}"/>
                            <TextBlock Text="更新包和游戏规则共用；按优先级尝试，0 表示禁用。" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,10">
                                <Button Content="添加前缀" Click="OnAddUpdateRoute" Margin="0,0,8,0"/>
                                <Button x:Name="DeleteUpdateRouteButton" Content="删除" Style="{StaticResource DangerButton}"
                                        Click="OnDeleteUpdateRoute" IsEnabled="False"/>
                            </StackPanel>
                            <DataGrid x:Name="UpdateRoutesGrid" Height="176" Margin="0,0,0,6" RowHeight="42"
                                      ItemsSource="{Binding UpdateRoutes, RelativeSource={RelativeSource AncestorType=Window}}"
                                      SelectionChanged="OnUpdateRouteSelectionChanged" IsReadOnly="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="类型" Binding="{Binding Type}" IsReadOnly="True" Width="90" MinWidth="90" ElementStyle="{StaticResource GridTextStyle}"/>
                                    <DataGridTemplateColumn Header="地址" Width="*" MinWidth="280">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBox Text="{Binding BaseUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         IsReadOnly="{Binding IsDirect}" BorderThickness="0" Background="Transparent"
                                                          ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="优先级" Width="92" MinWidth="92">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ComboBox ItemsSource="{Binding UpdateRoutePriorities, RelativeSource={RelativeSource AncestorType=Window}}"
                                                          SelectedItem="{Binding Priority, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Text="第三方前缀线路会看到完整 GitHub 请求地址。直连线路始终保留，但可设为 0。"
                                       Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,0,0,12"/>
                            <TextBlock Text="HTTP 出网代理（可选，仅 http://host:port）" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6"/>
                            <TextBox x:Name="HttpProxyBox" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                            <Button Content="检查更新" Click="OnCheckForUpdates" HorizontalAlignment="Left" Margin="0,12,0,0"/>

                            <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,24"/>
                            <TextBlock Text="诊断" Style="{StaticResource SettingsSectionTitle}"/>
                            <CheckBox x:Name="DebugLogCheck" Content="启用 Debug 日志" Margin="0,12,0,2"/>
                            <TextBlock Text="日志保存在当前用户的 PathEcho Logs 目录，最多保留 5 个滚动文件。"
                                       Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,2,0,8"/>
                            <WrapPanel><Button Content="打开日志目录" Click="OnOpenLogs" Margin="0,0,8,0"/><Button Content="检查与导出诊断" Click="OnHistoryDiagnostics"/></WrapPanel>

                        </StackPanel>
                    </ScrollViewer>
                    <Border Grid.Row="3" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,16,0,0" Margin="0,12,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="保存设置" Style="{StaticResource PrimaryButton}" Click="OnSaveSettings" MinWidth="104"/>
                            <Button Content="发现已有备份" Click="OnDiscoverBackups" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>

            <Border Grid.Row="1" Background="#E8EEEB" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                <Grid Margin="28,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock x:Name="StatusText" Text="就绪" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" Margin="0,0,16,0" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                    <TextBlock x:Name="BackgroundStatusText" Grid.Column="1" Text="后台监听已启用" Foreground="#167A5B" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
