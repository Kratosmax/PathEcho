<Window x:Class="PathEcho.Dialogs.SyncTaskEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="新建同步任务" Width="680" Height="720" MinWidth="600" MinHeight="640"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="HeadingText" Text="新建同步任务" FontSize="22" FontWeight="SemiBold"/>
        <StackPanel Grid.Row="1" Margin="0,18,0,0">
            <TextBlock Text="名称" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6"/>
            <TextBox x:Name="NameBox" Text="我的同步"/>
        </StackPanel>
        <StackPanel Grid.Row="2" Margin="0,14,0,0">
            <TextBlock Text="左侧目录" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="LeftPathBox"/><Button Grid.Column="2" Content="浏览" Click="OnBrowseLeft"/>
            </Grid>
        </StackPanel>
        <StackPanel Grid.Row="3" Margin="0,14,0,0">
            <TextBlock Text="右侧目录" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="RightPathBox"/><Button Grid.Column="2" Content="浏览" Click="OnBrowseRight"/>
            </Grid>
        </StackPanel>
        <Grid Grid.Row="4" Margin="0,14,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="同步方向" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6"/><ComboBox x:Name="ModeBox"/></StackPanel>
            <StackPanel Grid.Column="2"><TextBlock Text="删除策略" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6"/><ComboBox x:Name="DeletionBox"/></StackPanel>
            <StackPanel Grid.Column="4"><TextBlock Text="冲突策略" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6"/><ComboBox x:Name="ConflictBox"/></StackPanel>
        </Grid>
        <CheckBox Grid.Row="5" x:Name="AutoStartCheck" Content="PathEcho 启动后自动监听" IsChecked="True" Margin="0,15,0,0"/>
        <Grid Grid.Row="6" Margin="0,15,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="包含规则（每行一个 glob）" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6"/>
                <TextBox x:Name="IncludePatternsBox" Height="84" AcceptsReturn="True" VerticalContentAlignment="Top"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="排除规则（每行一个 glob）" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6"/>
                <TextBox x:Name="ExcludePatternsBox" Height="84" AcceptsReturn="True" VerticalContentAlignment="Top"/>
            </StackPanel>
        </Grid>
        <TextBlock Grid.Row="7" Text="示例：Saves/**、*.tmp。排除规则优先；包含留空表示全部。" Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,6,0,0"/>
        <TextBlock Grid.Row="8" x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,12,0,0"/>
        <StackPanel Grid.Row="10" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" IsCancel="True" Margin="0,0,8,0"/>
            <Button x:Name="SaveButton" Content="创建" Style="{StaticResource PrimaryButton}" Click="OnCreate"/>
        </StackPanel>
    </Grid>
</Window>
