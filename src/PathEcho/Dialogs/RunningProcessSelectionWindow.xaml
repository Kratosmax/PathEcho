<Window x:Class="PathEcho.Dialogs.RunningProcessSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="选择运行中的游戏" Width="840" Height="560" MinWidth="680" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Loaded="OnLoaded">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="14"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="选择运行中的游戏" FontSize="22" FontWeight="SemiBold"/>
                <TextBlock x:Name="ProcessCountText" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Content="刷新" Click="OnRefresh"/>
        </Grid>
        <TextBox x:Name="SearchBox" Grid.Row="2" TextChanged="OnSearchChanged" ToolTip="搜索程序名、PID、窗口标题或路径"/>
        <DataGrid x:Name="ProcessGrid" Grid.Row="4" ItemsSource="{Binding Processes}" SelectionChanged="OnSelectionChanged"
                  MouseDoubleClick="OnProcessDoubleClick">
            <DataGrid.Columns>
                <DataGridTextColumn Header="程序" Binding="{Binding Name}" Width="150" ElementStyle="{StaticResource GridTextStyle}"/>
                <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="72" ElementStyle="{StaticResource GridTextStyle}"/>
                <DataGridTextColumn Header="窗口标题" Binding="{Binding WindowTitle}" Width="1.2*" MinWidth="150" ElementStyle="{StaticResource GridTextStyle}"/>
                <DataGridTextColumn Header="程序路径" Binding="{Binding ExecutablePath}" Width="2*" MinWidth="240" ElementStyle="{StaticResource GridTextStyle}"/>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" IsCancel="True" Margin="0,0,8,0"/>
            <Button x:Name="SelectButton" Content="选择" Style="{StaticResource PrimaryButton}" Click="OnSelect" IsEnabled="False"/>
        </StackPanel>
    </Grid>
</Window>
