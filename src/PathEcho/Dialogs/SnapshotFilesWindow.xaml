<Window x:Class="PathEcho.Dialogs.SnapshotFilesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="版本文件" Width="900" Height="620" MinWidth="700" MinHeight="460"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="12"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock x:Name="TitleText" Text="版本文件" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock x:Name="SummaryText" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/>
        </StackPanel>
        <Grid Grid.Row="2">
            <TextBox x:Name="SearchBox" Padding="34,7,10,7" TextChanged="OnSearchChanged" ToolTip="搜索文件名或所在目录"/>
            <TextBlock Text="⌕" FontSize="20" Foreground="{StaticResource MutedBrush}" Margin="11,0,0,1" VerticalAlignment="Center" IsHitTestVisible="False"/>
            <TextBlock x:Name="SearchHint" Text="搜索版本中的文件" Foreground="#87948F" Margin="34,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
        </Grid>
        <Grid Grid.Row="4">
            <DataGrid x:Name="FilesGrid" FrozenColumnCount="1">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="文件名" Binding="{Binding FileName}" Width="1.1*" MinWidth="140" ElementStyle="{StaticResource GridTextStyle}"/>
                    <DataGridTextColumn Header="所在目录" Binding="{Binding DirectoryName}" Width="1.6*" MinWidth="160" ElementStyle="{StaticResource GridTextStyle}"/>
                    <DataGridTextColumn Header="修改时间" Binding="{Binding LastWriteTime}" Width="160" ElementStyle="{StaticResource GridTextStyle}"/>
                    <DataGridTextColumn Header="大小" Binding="{Binding Size}" Width="145" ElementStyle="{StaticResource GridTextStyle}"/>
                </DataGrid.Columns>
            </DataGrid>
            <StackPanel x:Name="EmptyState" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="这个版本没有文件" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
            </StackPanel>
            <StackPanel x:Name="NoResultsState" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="未找到匹配的文件" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                <Button Content="清除搜索" Click="OnClearSearch" Margin="0,14,0,0"/>
            </StackPanel>
        </Grid>
        <Button Grid.Row="6" Content="关闭" IsCancel="True" HorizontalAlignment="Right"/>
    </Grid>
</Window>
