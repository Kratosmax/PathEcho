<Window x:Class="PathEcho.Dialogs.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PathEcho 更新" Width="580" Height="430" MinWidth="520" MinHeight="360"
        ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="16"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="软件更新" FontSize="22" FontWeight="SemiBold"/>
        <TextBlock x:Name="VersionText" Grid.Row="1" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/>
        <Border Grid.Row="3" Background="#DDF4F7F8" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="14">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="NotesText" TextWrapping="Wrap" LineHeight="21"/>
            </ScrollViewer>
        </Border>
        <StackPanel Grid.Row="4" Margin="0,14,0,0">
            <TextBlock x:Name="StatusText" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6"/>
            <ProgressBar x:Name="DownloadProgress" Height="6" Minimum="0" Maximum="100" Visibility="Collapsed"/>
        </StackPanel>
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="SecondaryButton" Content="稍后" Click="OnSecondary" Margin="0,0,8,0"/>
            <Button x:Name="PrimaryButton" Content="检查更新" Style="{StaticResource PrimaryButton}" Click="OnPrimary"/>
        </StackPanel>
    </Grid>
</Window>
