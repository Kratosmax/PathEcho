<Window x:Class="PathEcho.Dialogs.SyncPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="同步预演" Width="820" Height="580" MinWidth="680" MinHeight="440"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="*"/><RowDefinition Height="16"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock x:Name="HeadingText" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock x:Name="SummaryText" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/>
        </StackPanel>
        <Grid Grid.Row="2">
            <DataGrid x:Name="ActionsGrid" FrozenColumnCount="1">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="操作" Binding="{Binding Action}" Width="125" ElementStyle="{StaticResource GridTextStyle}"/>
                    <DataGridTextColumn Header="相对路径" Binding="{Binding RelativePath}" Width="*" MinWidth="300" ElementStyle="{StaticResource GridTextStyle}"/>
                    <DataGridTextColumn Header="说明" Binding="{Binding Reason}" Width="1.2*" MinWidth="150" ElementStyle="{StaticResource GridTextStyle}"/>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock x:Name="EmptyText" Text="没有需要执行的操作，两端已一致。" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
        </Grid>
        <Button Grid.Row="4" Content="关闭" IsCancel="True" HorizontalAlignment="Right"/>
    </Grid>
</Window>
