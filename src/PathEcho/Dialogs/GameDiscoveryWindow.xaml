<Window x:Class="PathEcho.Dialogs.GameDiscoveryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="智能识别游戏" Width="860" Height="560" MinWidth="700" MinHeight="430"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="*"/><RowDefinition Height="16"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="智能识别游戏" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock x:Name="SourceText" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0"/>
        </StackPanel>
        <Grid Grid.Row="2">
            <DataGrid x:Name="GamesGrid" SelectionMode="Single" MouseDoubleClick="OnDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="游戏" Binding="{Binding Name}" Width="1.2*" MinWidth="150" ElementStyle="{StaticResource GridTextStyle}"/>
                    <DataGridTextColumn Header="进程" Binding="{Binding Process}" Width="1.2*" MinWidth="150" ElementStyle="{StaticResource GridTextStyle}"/>
                    <DataGridTextColumn Header="存档目录" Binding="{Binding SaveDirectory}" Width="2.2*" MinWidth="260" ElementStyle="{StaticResource GridTextStyle}"/>
                    <DataGridTextColumn Header="目录状态" Binding="{Binding DirectoryState}" Width="90" ElementStyle="{StaticResource GridTextStyle}"/>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock x:Name="EmptyText" Text="当前运行的程序中没有匹配到已知游戏。" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"/>
        </Grid>
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" IsCancel="True" Margin="0,0,8,0"/>
            <Button Content="使用选中游戏" Style="{StaticResource PrimaryButton}" Click="OnSelect"/>
        </StackPanel>
    </Grid>
</Window>
